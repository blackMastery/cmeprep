# Local secrets for Edge Functions — copy to supabase/functions/.env (gitignored).
# `supabase start` loads that file automatically; hosted projects use
# `supabase secrets set OPENAI_API_KEY=... OPENAI_TRANSLATION_MODEL=...`.
#
# The translate-question function calls OpenAI with this key. Unset = the
# function answers not_configured and students see "translation unavailable".
OPENAI_API_KEY=
# Optional; the default lives in supabase/functions/_shared/translation-core.ts.
OPENAI_TRANSLATION_MODEL=gpt-5.6-sol
