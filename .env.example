# Supabase — copy to .env.local and fill in.
# Local dev values are printed by `npx supabase start`.

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY — never prefix with NEXT_PUBLIC_, never import outside
# lib/supabase/admin.ts. Bypasses Row Level Security. The legacy service_role
# JWT (`eyJ…`) or an `sb_secret_…` key both work here.
SUPABASE_ADMIN_SECRET_KEY=

# SERVER ONLY — what the app sends to the translate-question Edge Function
# (lib/translations.ts). MUST be the new-format `sb_secret_…` key
# (`supabase status` locally; Project Settings → API Keys → Secret keys
# hosted): the function's secret mode rejects the legacy JWT with a 401.
SUPABASE_SECRET_KEY=

# Site URL used for auth email redirect links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Social sign-in (Google) — read by the Supabase CLI via config.toml env()
# substitution when starting the LOCAL stack, not by Next.js. The CLI reads a
# repo-root .env (gitignored) or the shell environment — it does NOT read
# .env.local, so put these in .env.
# Google: console.cloud.google.com → APIs & Services → Credentials.
# The hosted project takes its credentials from the dashboard instead
# (Authentication → Sign In / Providers). Setup steps: see README.
# LinkedIn is disabled for now — see [auth.external.linkedin_oidc] in
# supabase/config.toml for what to restore.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# PayPal — credentials from developer.paypal.com → Apps & Credentials.
# 'sandbox' | 'live' — picks the API base URL.
PAYPAL_ENV=sandbox

# The client ID is public by design (it ships in the SDK script URL);
# both vars hold the SAME value.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=

# SERVER ONLY
PAYPAL_CLIENT_SECRET=

# From the webhook registered in the PayPal dashboard. Leave empty in local
# dev: the webhook route then answers 503 and the capture route alone grants
# access. Required in production for refunds/reconciliation.
PAYPAL_WEBHOOK_ID=

# SERVER ONLY — OpenAI, used solely to grade OSCE free-text answers
# (lib/openai.ts). Without it the grade route fails and students see
# "grading unavailable" — MCQ tests are unaffected. OPENAI_MODEL is
# optional; the default lives in lib/openai.ts (gpt-5-mini).
OPENAI_API_KEY=
OPENAI_MODEL=

# On-demand question translation runs in the Supabase Edge Function
# supabase/functions/translate-question, which reads OPENAI_API_KEY (and the
# optional OPENAI_TRANSLATION_MODEL, default gpt-5.6-sol) from FUNCTION
# secrets, not from this file: `supabase secrets set OPENAI_API_KEY=…` on the
# hosted project, supabase/functions/.env locally (see functions/.env.example).
# The app reaches the function with SUPABASE_SECRET_KEY above.

# SERVER ONLY — shared secret for the reconciliation sweep at
# /api/cron/reconcile. Generate one with `openssl rand -hex 32`.
#
# The schedule lives in the DATABASE, not in a platform cron: pg_cron fires
# net.http_post at the route with this value as a bearer token, read from
# Supabase Vault. So it has to be set in TWO places in production — here (the
# hosting env) and once in the SQL editor:
#
#   select vault.create_secret('<this value>', 'reconcile_cron_secret');
#   select vault.create_secret('https://www.cmeqbank.com/api/cron/reconcile',
#                              'reconcile_url');
#
# Leave empty in local dev: the route then answers 503 and refuses to sweep, so
# a missing secret can never quietly mean "unauthenticated sweeps are fine".
# To run one locally, set it and POST the same bearer header by hand.
CRON_SECRET=

# ── AI tutor ─────────────────────────────────────────────────
# Base URL of the FastAPI tutor service (the cmeprep-ai-tutor repo, deployed to
# Render). Server-only and deliberately NOT NEXT_PUBLIC_: the browser never
# calls the tutor directly — /api/tutor/chat proxies it, which is the only
# place entitlement and the message caps are enforced. Unset = the tutor page
# renders as unavailable rather than falling back to localhost.
TUTOR_API_URL=http://127.0.0.1:8000
# Must match TUTOR_SHARED_SECRET on the tutor service, which refuses to start
# without it. Sent as X-Tutor-Secret so a valid Supabase token alone can't
# reach the tutor and bypass entitlement and the message caps. Put the real
# value in .env.local (gitignored) — this file is committed.
TUTOR_SHARED_SECRET=local-dev-secret
